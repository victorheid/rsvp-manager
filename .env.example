# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rsvp_manager?schema=public"

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Web push (§9). Generate the pair with: npx web-push generate-vapid-keys
# Without these, push messages are logged to the server console instead.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
