# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rsvp_manager?schema=public"

# Signs session cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Web push (§9). Generate the pair with: npx web-push generate-vapid-keys
# Without these, push messages are logged to the server console instead.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Public address of the app, used for links in SMS messages (optional).
APP_URL="http://localhost:3000"

# The wallet is off in production until the legal check clears; set to "true" to switch it on.
# WALLET_ENABLED="false"

# Stripe (test mode keys start with sk_test_ / pk_test_). Without STRIPE_SECRET_KEY the in-memory fake runs.
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Stripe webhooks (payment / account updates). Locally: `stripe listen --events payment_intent.succeeded,payment_intent.payment_failed,account.updated --forward-to localhost:3000/api/stripe/webhook`
# prints a whsec_… secret to put here; in production, create an endpoint in the Stripe dashboard for
# payment_intent.succeeded, payment_intent.payment_failed and account.updated.
STRIPE_WEBHOOK_SECRET=""
