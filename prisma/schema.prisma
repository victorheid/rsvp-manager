// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Groups & auth -----------------------------------------------------

model User {
  id          String   @id @default(cuid())
  phoneNumber String   @unique
  firstName   String
  lastInitial String
  createdAt   DateTime @default(now())

  memberships     GroupMembership[]
  organizedGroups Group[]           @relation("GroupOrganizer")
  rsvps           Rsvp[]
  waitlistEntries WaitlistEntry[]
  wallet          Wallet?
}

model Group {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  organizerId String
  createdAt   DateTime @default(now())

  organizer   User              @relation("GroupOrganizer", fields: [organizerId], references: [id])
  memberships GroupMembership[]
  events      Event[]
}

model VerificationCode {
  id          String    @id @default(cuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

// --- Events --------------------------------------------------------------

enum PricingMode {
  FIXED_PER_HEAD
  SPLIT_EVENLY
}

enum EventStatus {
  OPEN
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Event {
  id                 String      @id @default(cuid())
  slug               String      @unique
  groupId            String
  title              String
  description        String?
  startsAt           DateTime
  location           String
  cutoffAt           DateTime
  minPlayers         Int         @default(1)
  maxPlayers         Int?
  totalCostCents     Int
  pricingMode        PricingMode
  cashAllowed        Boolean     @default(false)
  autoChargeAtCutoff Boolean     @default(true)
  status             EventStatus @default(OPEN)
  confirmedAt        DateTime?
  lockedPriceCents   Int?
  createdAt          DateTime    @default(now())

  group           Group           @relation(fields: [groupId], references: [id])
  rsvps           Rsvp[]
  waitlistEntries WaitlistEntry[]
}

// --- RSVPs & waitlist ------------------------------------------------------

enum PaymentMethod {
  WALLET
  CARD
  CASH
}

enum RsvpStatus {
  GOING
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD
  CHARGED
  OWES
  REFUNDED
}

model Rsvp {
  id            String        @id @default(cuid())
  eventId       String
  userId        String
  status        RsvpStatus    @default(GOING)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  attended      Boolean?
  createdAt     DateTime      @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

enum WaitlistPromotionMode {
  AUTO
  MANUAL
}

model WaitlistEntry {
  id            String                @id @default(cuid())
  eventId       String
  userId        String
  paymentMethod PaymentMethod
  promotionMode WaitlistPromotionMode @default(AUTO)
  createdAt     DateTime              @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

// --- Wallet ----------------------------------------------------------------

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceCents Int      @default(0)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}
