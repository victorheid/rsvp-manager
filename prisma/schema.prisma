// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Groups & auth -----------------------------------------------------

model User {
  id               String   @id @default(cuid())
  phoneNumber      String   @unique
  firstName        String
  lastInitial      String
  createdAt        DateTime @default(now())
  // The payment provider's customer for this user, created on first payment (§5).
  stripeCustomerId String?  @unique
  // Stripe Connect account for receiving payouts as an organizer (§5); payoutsEnabled
  // is refreshed from the provider when the organizer returns from onboarding.
  stripeAccountId  String?  @unique
  payoutsEnabled   Boolean  @default(false)

  memberships       GroupMembership[]
  organizedGroups   Group[]            @relation("GroupOrganizer")
  rsvps             Rsvp[]
  waitlistEntries   WaitlistEntry[]
  wallet            Wallet?
  pushSubscriptions PushSubscription[]
  payments          Payment[]
}

model Group {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  organizerId String
  createdAt   DateTime @default(now())

  organizer   User              @relation("GroupOrganizer", fields: [organizerId], references: [id])
  memberships GroupMembership[]
  events      Event[]
}

model VerificationCode {
  id          String    @id @default(cuid())
  phoneNumber String
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([phoneNumber])
}

model GroupMembership {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

// --- Events --------------------------------------------------------------

enum PricingMode {
  FIXED_PER_HEAD
  SPLIT_EVENLY
}

enum EventStatus {
  OPEN
  CONFIRMED
  CANCELLED
  EXPIRED
}

model Event {
  id                   String      @id @default(cuid())
  slug                 String      @unique
  groupId              String
  title                String
  description          String?
  startsAt             DateTime
  endsAt               DateTime
  location             String
  cutoffAt             DateTime
  minPlayers           Int         @default(1)
  maxPlayers           Int?
  totalCostCents       Int
  costBreakdown        Json?
  pricingMode          PricingMode
  cashAllowed          Boolean     @default(false)
  // §5 payment options: cash and/or online (wallet, card). Online needs the organizer onboarded.
  onlineAllowed        Boolean     @default(false)
  autoChargeAtCutoff   Boolean     @default(true)
  status               EventStatus @default(OPEN)
  confirmedAt          DateTime?
  lockedPriceCents     Int?
  // Set when the §9 cut-off reminder went out, so the worker sends it once.
  cutoffReminderSentAt DateTime?
  // Set when the organizer was alerted that the cut-off passed unconfirmed (§9).
  organizerAlertedAt   DateTime?
  // §5: the fee schedule live when the event was created; every payment for it uses this one.
  feeScheduleId        String
  createdAt            DateTime    @default(now())

  group           Group           @relation(fields: [groupId], references: [id])
  feeSchedule     FeeSchedule     @relation(fields: [feeScheduleId], references: [id])
  payout          Payout?
  rsvps           Rsvp[]
  waitlistEntries WaitlistEntry[]
}

// --- RSVPs & waitlist ------------------------------------------------------

enum PaymentMethod {
  WALLET
  CARD
  CASH
}

enum RsvpStatus {
  GOING
  CANCELLED
}

enum PaymentStatus {
  PENDING
  HELD
  CHARGED
  OWES
  PAID_OUTSIDE_APP
  REFUNDED
}

model Rsvp {
  id                    String        @id @default(cuid())
  eventId               String
  // Exactly one of userId/walkInName is set — enforced in code (addWalkIn
  // only ever sets walkInName, every other action only ever sets userId),
  // not a DB constraint, since only those two paths ever write this row.
  userId                String?
  walkInName            String?
  status                RsvpStatus    @default(GOING)
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(PENDING)
  attended              Boolean?
  // Card RSVPs (§5): the card saved at RSVP time, charged at confirmation.
  // payToken is the secret in the /pay/{token} link for a failed charge.
  stripePaymentMethodId String?
  cardBrand             String?
  cardLast4             String?
  payToken              String?       @unique
  createdAt             DateTime      @default(now())

  event    Event     @relation(fields: [eventId], references: [id])
  user     User?     @relation(fields: [userId], references: [id])
  payments Payment[]

  @@unique([eventId, userId])
}

enum WaitlistPromotionMode {
  AUTO
  MANUAL
}

model WaitlistEntry {
  id                    String                @id @default(cuid())
  eventId               String
  userId                String
  // Null for MANUAL ("notify me") entries — no payment method is picked
  // until they claim a spot. AUTO ("auto-join and pay") entries would
  // have one, but AUTO isn't offered yet (needs wallet/card, §5).
  paymentMethod         PaymentMethod?
  promotionMode         WaitlistPromotionMode @default(MANUAL)
  // AUTO card entries: the card saved when joining the waitlist (§6), charged on move-in.
  stripePaymentMethodId String?
  cardBrand             String?
  cardLast4             String?
  createdAt             DateTime              @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
}

// --- Wallet ----------------------------------------------------------------

model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  balanceCents Int      @default(0)
  updatedAt    DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  entries WalletEntry[]
  holds   WalletHold[]
}

enum WalletEntryKind {
  TOP_UP
  GAME_PAYMENT
  REFUND
}

// The wallet's audit trail: every change to balanceCents has exactly one
// entry, with the signed amount.
model WalletEntry {
  id          String          @id @default(cuid())
  walletId    String
  kind        WalletEntryKind
  amountCents Int
  paymentId   String?
  createdAt   DateTime        @default(now())

  wallet  Wallet   @relation(fields: [walletId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@index([walletId])
}

enum WalletHoldStatus {
  HELD
  REALIZED
  RELEASED
}

// §5: a hold reduces the *available* balance but moves no money. Realized at
// confirmation (the price is debited, the rest released) or released if the
// RSVP or event is cancelled first.
model WalletHold {
  id          String           @id @default(cuid())
  walletId    String
  rsvpId      String           @unique
  amountCents Int
  status      WalletHoldStatus @default(HELD)
  createdAt   DateTime         @default(now())
  settledAt   DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([walletId, status])
}

// --- Payments ----------------------------------------------------------------

enum PaymentKind {
  TOP_UP
  GAME_CARD
  GAME_WALLET
}

enum PaymentRecordStatus {
  PENDING
  SUCCEEDED
  FAILED
}

// One row per attempt to move money in or out for a player (§5). The service
// fee is stored as charged and never recalculated; refunds are tracked
// separately for the price and the fee (only a cancelled confirmed event
// refunds the fee).
model Payment {
  id               String              @id @default(cuid())
  userId           String
  kind             PaymentKind
  status           PaymentRecordStatus @default(PENDING)
  rsvpId           String?
  // What the player paid for: the price of the game, or the credit a top-up adds.
  amountCents      Int
  feeCents         Int
  feeScheduleId    String
  refundedCents    Int                 @default(0)
  feeRefundedCents Int                 @default(0)
  providerIntentId String?
  providerChargeId String?
  createdAt        DateTime            @default(now())

  user          User          @relation(fields: [userId], references: [id])
  rsvp          Rsvp?         @relation(fields: [rsvpId], references: [id])
  walletEntries WalletEntry[]

  @@index([userId])
  @@index([rsvpId])
}

// --- Notifications -----------------------------------------------------------

// One row per browser/device a user allowed web push on (§9). The endpoint
// identifies the device; a user can have several.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// --- Fees ----------------------------------------------------------------------

// §5: versioned, never edited in place — a change is a new row with a later
// effectiveFrom. Tiers are JSON (see fees/rules.ts for the shape, parsed
// with Zod on read).
model FeeSchedule {
  id               String   @id @default(cuid())
  version          Int      @unique
  effectiveFrom    DateTime
  gameCardFeeTiers Json
  topUpFeeTiers    Json
  createdAt        DateTime @default(now())

  events Event[]
}

// --- Payouts -------------------------------------------------------------------

// §5: money released to the organizer after the event (+2 days). One per event.
model Payout {
  id                 String   @id @default(cuid())
  eventId            String   @unique
  organizerId        String
  amountCents        Int
  // Null when there was nothing to pay (everyone paid cash, or was refunded).
  providerTransferId String?
  releasedAt         DateTime

  event Event @relation(fields: [eventId], references: [id])
}
